# Railway / local keeper env. Never commit real .env.

# Use a dedicated provider on Railway (Alchemy/Infura/QuickNode). Bare mainnet.base.org rate-limits.
# If unset, keeper uses llamarpc + 1rpc fallbacks (not mainnet.base.org as primary).
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
KEEPER_KEY=

# Live deploy v2 (claimDoppler + BNKR/TEST routing)
BANKR_FEE_ROUTER=0x9eECd13b1D21E550E6B9294B9cC958188D94711F
BANKR_RENEWER_DISTRIBUTOR=0x2a3D662ec48498C85FdfdE2C61C88EE19f77BA3B
CLANKER_FEE_LOCKER=0xF3622742b1E446D92e45E22923Ef11C2fcD55D68
PAIRED_TOKEN=0x22aF33FE49fD1Fa80c7149773dDe5890D3c76F3b
PROJECT_TOKEN=

DUNE_API_KEY=
DUNE_QUERY_ID=5839788

# August epoch 1 — whole month through today
EPOCH_MODE=august_backfill
EPOCH_START=2026-08-01
EPOCH_END=2026-08-28
INCLUDE_NEW_SIGNUPS=true

PAY_BATCH_SIZE=40

